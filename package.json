{
  "name": "vite-esbuild",
  "version": "1.0.0",
  "description": "esbuild 学习",
  "main": "index.js",
  "scripts": {
    "dev": "esbuild src/index.js --outfile=dist/index.js --watch",
    "build": "esbuild src/index.js --outfile=dist/prod.js --bundle",
    "node":"esbuild src/index.js --outfile=dist/prod.js --platform=node",
    "es":"esbuild src/index.js --outfile=dist/prod.js --bundle --format=esm",
    "commonjs":"esbuild src/index.js --outfile=dist/prod.js --bundle --format=cjs"
  },
  "keywords": [
    "esbuild"
  ],
  "author": "wdm",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.25.5"
  },
  "dependencies": {
    "react": "^19.1.0"
  }
}
